<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp" android:layout_margin="2dp" android:background="@drawable/widget_course_limited">
<TextView android:id="@+id/widget_accent" android:layout_width="3dp" android:layout_height="match_parent" android:minHeight="16dp" android:background="@color/widget_accent_limited" android:layout_marginEnd="6dp"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:id="@+id/widget_course_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_secondary" android:fontFamily="sans" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="" android:layout_marginBottom="3dp"/>
<TextView android:id="@+id/widget_course_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/widget_text" android:fontFamily="sans" android:includeFontPadding="false"  android:ellipsize="end" android:text="@string/widget_preview_course" android:textStyle="bold" android:maxLines="2"/>
<TextView android:id="@+id/widget_course_place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_secondary" android:fontFamily="sans" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_preview_place" android:layout_marginTop="3dp"/>
<TextView android:id="@+id/widget_course_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_text" android:fontFamily="sans" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="08:00 – 09:50" android:layout_marginTop="3dp"/>
</LinearLayout>
</LinearLayout>
