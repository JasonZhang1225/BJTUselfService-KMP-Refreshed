local.properties
/.idea/

# Local MIS credentials; never commit this file.
/MisSecret.md
/MisSecret.env

# Verification artifacts (baselines, screenshots, audit evidence); local only.
/.artifacts/

# Local build / IDE caches that must never be published
**/DerivedData*/
**/ModuleCache.noindex/
**/*.xcuserstate
**/xcuserdata/
*.hmap
*.ipa
*.dSYM/

# Local packaged app builds (APK/app/DMG); do not commit.
/builtapps/

# jpackage 生成的 WiX 中间文件（本地打包副产物；仓库里跟踪的 main.wxs 不受影响）。
/*.wxs
/multiplatform/*.wxs

# Android signing keys; never commit.
*.jks
*.keystore

# Local agent skills and memory.
/.agents/
/.workbuddy/
