# 仅键名示例；不要把真实值提交到 Git。
# 生产环境需通过 Sites 环境变量工具设置 Site 内拥有者 ID。
OWNER_USER_ID=
# OWNER_TOKEN 仅用于受控机器/本地兼容调用，不嵌入网页。
OWNER_TOKEN=
# 仅在部署者确认 Site 仅拥有者可访问后启用；首次可信 Sites 用户身份会固定入库。
# 已有 OWNER_USER_ID 时无需此引导；不是允许匿名访问的开关。
OWNER_PRIVATE_BOOTSTRAP=false

# Sites get_site 返回的本站服务访问令牌，由助手通过环境变量工具存为 secret。
# 仅在拥有者生成配对信息时交给其设备，不嵌入页面源码或聊天。
SITE_DEVICE_ACCESS=
