<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
<TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/widget_text" android:fontFamily="sans" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_preview_date" android:layout_weight="1" android:textStyle="bold"/>
<TextView android:id="@+id/widget_week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_text" android:fontFamily="sans" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_preview_week" android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:background="@drawable/widget_pill"/>
<ImageButton android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="match_parent" android:background="@android:color/transparent" android:src="@drawable/widget_refresh" android:padding="9dp" android:contentDescription="@string/widget_refresh_description"/>
</LinearLayout>
<TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_secondary" android:fontFamily="sans" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="" android:layout_marginBottom="4dp"/>
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
<TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="0dp" android:textSize="14sp" android:textColor="@color/widget_secondary" android:fontFamily="sans" android:includeFontPadding="false"  android:ellipsize="end" android:text="@string/widget_no_snapshot" android:layout_weight="1" android:gravity="center" android:maxLines="3" android:visibility="gone"/>
<TextView android:id="@+id/widget_footer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_secondary" android:fontFamily="sans" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="" android:layout_marginTop="3dp" android:visibility="gone"/>
</LinearLayout>
